# Server-only. Never prefix secrets with VITE_. Leave empty for review-only preview.
RESEND_API_KEY=
ENQUIRY_ENABLED=false
RESEND_FROM=
RESEND_DOMAIN_ID=
ENQUIRY_SECURITY_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Exact allowed origin(s), comma separated. VERCEL_URL is also allowed automatically.
APP_ORIGIN=
# Set only after the bakery confirms ownership and the production domain.
PUBLIC_SITE_URL=

# Stage 9A server-only configuration. Keep disabled until reviewed and tested.
ADMIN_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate 32 random bytes encoded as 64 hex characters; never use a password.
ADMIN_SESSION_SECRET=
# Exact approved HTTPS origin/admin/login; separate values for each environment.
ADMIN_RECOVERY_URL=
# Future Stage 9C public-read cutover; storefront currently uses supplied data.
CATALOGUE_DATABASE_ENABLED=false
