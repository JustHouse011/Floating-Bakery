{
  "name": "floating-bakery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {"node": "22.x"},
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:internal": "vite --mode internal --host 127.0.0.1 --port 5181",
    "build:internal": "tsc -b && vite build --mode internal --outDir .tools/internal-dist",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "test:delivery": "node scripts/test-delivery.mjs",
    "test:production-browser": "playwright test e2e/production.spec.mjs --project=journey-desktop --project=journey-mobile",
    "test:browser": "playwright test",
    "qa:audit": "node scripts/qa-audit.mjs",
    "qa:gpu": "node scripts/qa-gpu.mjs",
    "qa:bundle": "node scripts/qa-bundle-analysis.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "three": "^0.173.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  }
}
